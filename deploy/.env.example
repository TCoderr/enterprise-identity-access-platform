# Variables read by deploy/docker-compose.yml. scripts/local-stack.ps1 and .sh set them for you; this file only
# documents them. It contains placeholders and no secret. Secrets are files under the private local directory
# created by "local-stack init" and are mounted into containers; they are never passed as environment variables.

# Compose project name. Use a different "halka-*" name for an additional, isolated stack.
HALKA_PROJECT=halka

# Private directory created by init (absolute path or relative to deploy/).
HALKA_LOCAL_DIR=../.local

# Host and container ports. They are published on 127.0.0.1 only.
HALKA_IAM_PORT=9443
HALKA_PANO_PORT=9444
HALKA_RAPOR_PORT=9445
HALKA_API_PORT=9446
