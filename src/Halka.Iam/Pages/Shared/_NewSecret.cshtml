@model string
<section class="panel" aria-labelledby="secret-heading">
    <h2 class="panel__title" id="secret-heading">Client secret</h2>
    <div class="alert alert--warning" role="alert">
        <p><strong>Copy this secret now.</strong> It is shown only in this response. Halka ID stores a hash and cannot display it again; if it is lost, rotate the secret.</p>
    </div>
    <p class="secret-box" id="new-secret" data-testid="new-secret">@Model</p>
    <div class="cluster no-print">
        <button type="button" class="button button--secondary" data-copy-from="new-secret" data-copy-status="secret-status" hidden>Copy secret</button>
        <span id="secret-status" role="status" class="muted"></span>
    </div>
    <p class="muted">Keep it on the server of the application (a private file or secret store). It must never reach a browser.</p>
</section>
