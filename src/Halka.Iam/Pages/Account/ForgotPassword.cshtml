@page "/account/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
    ViewData["Width"] = "page--narrow";
}
<h1>Reset your password</h1>
@if (Model.Sent)
{
    <div class="alert alert--success" role="status">
        <p><strong>Check the demo mail sink.</strong></p>
        <p>If an account with a confirmed address exists, a reset link was written to the private mail sink of this installation. The link works once and expires after 30 minutes.</p>
    </div>
    <p><a href="/account/login">Back to sign in</a></p>
}
else
{
    <p>Enter the e-mail address of your account. For privacy, the answer is the same whether or not the account exists.</p>
    <form method="post" asp-page="/Account/ForgotPassword" class="panel" novalidate>
        <div class="field">
            <label asp-for="Email">E-mail address</label>
            <input asp-for="Email" type="email" autocomplete="username" inputmode="email" required>
            <span asp-validation-for="Email" class="field__error"></span>
        </div>
        <button type="submit" class="button button--block">Send reset link</button>
    </form>
    <p><a href="/account/login">Back to sign in</a></p>
}
