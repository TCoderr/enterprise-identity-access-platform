@page "/account/reset-password"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["Width"] = "page--narrow";
}
<h1>Choose a new password</h1>
@if (Model.TokenInvalid)
{
    <div class="alert alert--error" role="alert">
        <p>This reset link is not valid any more. It may have expired or already been used.</p>
    </div>
    <p><a href="/account/forgot-password">Request a new link</a></p>
}
else
{
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert--error" role="alert" id="reset-error">
            <ul>
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    <p>After the change, every session and application grant of your account is signed out. An enrolled authenticator stays active.</p>
    <form method="post" asp-page="/Account/ResetPassword" class="panel" novalidate>
        <input type="hidden" asp-for="Token">
        <div class="field">
            <label asp-for="NewPassword">New password</label>
            <span class="field__hint" id="new-password-hint">At least 12 characters.</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required aria-describedby="new-password-hint">
        </div>
        <button type="submit" class="button button--block">Change password</button>
    </form>
}
