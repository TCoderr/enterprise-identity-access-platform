@page "/manage/password"
@model PasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Nav"] = "account";
    ViewData["Side"] = "password";
}
<div class="with-sidebar">
    <partial name="_ManageNav" />
    <div>
        <h1>Change password</h1>
        @if (Model.Notice is not null)
        {
            <div class="alert alert--success" role="status"><p>@Model.Notice</p></div>
        }
        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert--error" role="alert" id="password-error">
                <ul>
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <form method="post" asp-page="/Manage/Password" class="panel" novalidate>
            <p>Changing the password signs out your other sessions and the applications opened from them. This browser stays signed in.</p>
            <div class="field">
                <label asp-for="CurrentPassword">Current password</label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required>
            </div>
            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <span class="field__hint" id="new-password-hint">At least 12 characters.</span>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required aria-describedby="new-password-hint">
            </div>
            <button type="submit" class="button">Change password</button>
        </form>
    </div>
</div>
