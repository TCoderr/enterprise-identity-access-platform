<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Halka.Iam</RootNamespace>
    <AssemblyName>Halka.Iam</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Halka.Shared\Halka.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI assets are embedded so they are served identically under dotnet run, tests and containers. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**\*" />
    <None Remove="ui-tooling\**" />
    <Content Remove="ui-tooling\**" />
    <Compile Remove="ui-tooling\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Halka.UnitTests" />
    <InternalsVisibleTo Include="Halka.IntegrationTests" />
    <InternalsVisibleTo Include="Halka.TestKit" />
  </ItemGroup>
</Project>
